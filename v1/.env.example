# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or a local server).
MONGODB_URI=mongodb://127.0.0.1:27017/videochat

# Long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional (recommended): Xirsys account for TURN servers. Find these values in
# your Xirsys dashboard under "API Info". The server asks Xirsys for temporary
# credentials on every call, so the secret never reaches the browser.
# XIRSYS_IDENT=your-ident
# XIRSYS_SECRET=your-secret
# XIRSYS_CHANNEL=your-channel
# XIRSYS_URL=https://global.xirsys.net

# Optional: ICE servers (STUN/TURN) as JSON, used when Xirsys is not set or fails. Without it a public Google STUN
# server is used, which works on most home networks but not behind strict NATs.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:example.com:3478","username":"user","credential":"pass"}]

# Optional: port of the HTTP server (default 3000).
# PORT=3000

# Set to "production" when deploying behind HTTPS so the cookie is marked secure.
# NODE_ENV=production
