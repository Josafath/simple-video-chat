<!DOCTYPE html>
<html lang="en">
<head>
    <title>Welcome <%= currentUser.name %>!</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="icon" href="/images/favicon.ico"/>
    <meta name="description" content="Learn with Student Partner to study DS and Algo"/>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <%if (currentUser) { %>
        <ul>
            <li><a class="active" href="/home">Home</a></li>
            <li><a href="/home/join">Join</a></li>
            <li><form action="/log-out" method="POST"><button type="submit" class="nav-button">Log Out</button></form></li>
        </ul>
        <div class="container-home">
            <div class="box">
                <div>
                    <h1>Hi <i><%= currentUser.name %></i> !</h1>
                    <p>Are you ready to study?</p>
                </div>
                <% if (locals.error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
                <form action="" method="POST">
                    <input type="text" name="room" class="create" autocomplete="off" placeholder="room's name" maxlength="50" required> <br>
                    <div class="botones_to_create_or_join">
                        <button type="submit" id="create" class="host-meeting" value="create" name="create">Create Meeting</button>
                    </div>
                </form>
                <p class="hint">Rooms are private: share the invite link with your partner. A room is deleted after a day without use.</p>
                <% if (locals.rooms && rooms.length) { %>
                    <section class="my-rooms" aria-labelledby="my-rooms-title">
                        <h2 id="my-rooms-title">Your rooms</h2>
                        <ul>
                            <% rooms.forEach((room) => { %>
                                <li>
                                    <a href="<%= room.url %>"><%= room.name %></a>
                                    <span class="expires">expires <time datetime="<%= room.expiresAt.toISOString() %>"><%= room.expiresAt.toUTCString() %></time></span>
                                </li>
                            <% }) %>
                        </ul>
                    </section>
                <% } %>
            </div>
        </div>
    <% } %>
    
</body>
</html>