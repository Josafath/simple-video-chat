<!DOCTYPE html>
<html lang="en">
<head>
    <title>Join Meeting</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="icon" href="/images/favicon.ico"/>
    <meta name="description" content="Learn with Student Partner to study DS and Algo"/>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <%if (currentUser) { %>
        <ul>
            <li><a href="/home">Home</a></li>
            <li><a class="active" href="/home/join">Join</a></li>
            <li><form action="/log-out" method="POST"><button type="submit" class="nav-button">Log Out</button></form></li>
        </ul>
        <div class="container-home">
            <div class="box">
                <div>
                    <h1>Hi <i><%= currentUser.name %></i> !</h1>
                    <p>Paste the invite link your partner sent you.</p>
                </div>
                <% if (locals.error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
                <form action="" method="POST">
                    <input type="text" name="invite" class="create" autocomplete="off" placeholder="https://…/room/…" maxlength="300" aria-label="Invite link" required> <br>
                    <div class="botones_to_create_or_join">
                        <button type="submit" id="create" class="host-meeting" value="create">Join Meeting</button>
                    </div>
                    
                </form>
            </div>
        </div>
    <% } %>
</body>
</html>