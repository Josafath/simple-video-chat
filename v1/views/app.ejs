<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/style_video_chat.css' />
    <link rel="icon" href="/images/favicon.ico"/>
    <meta name="description" content="Learn with Student Partner to study DS and Algo"/>
    <title><%= title %></title>
</head>
<body data-room-id="<%= room.token %>">

    <!-- Three rows that always fit the screen: room info, the video, the controls. -->
    <header class="room-info">
        <p class="room-name">Room: <strong><%= room.name %></strong></p>
        <p id="call-status" role="status"></p>
        <div class="invite">
            <label for="invite-link">Invite link</label>
            <input id="invite-link" type="text" value="<%= inviteUrl %>" readonly>
            <button type="button" id="copy-invite">Copy invite link</button>
        </div>
    </header>

    <main class="video-chat-container">
        <!-- The partner fills the space; your own camera is a small picture in the corner. -->
        <video autoplay class="remote-video" id="remote-video" playsinline aria-label="Your partner's video"></video>
        <!-- muted: without it you hear your own microphone back -->
        <video autoplay muted class="local-video" id="local-video" playsinline aria-label="Your camera"></video>
    </main>

    <nav class="controls" aria-label="Call controls">
        <button id="hangup" type="button">Hang up</button>
        <button class="chat-btn" type="button" aria-controls="chat-panel" aria-expanded="false">Chat</button>
    </nav>

    <section class="chat-popup" id="chat-panel" aria-label="Chat">
        <div class="chat-area" aria-live="polite"></div>

        <form class="input-area" autocomplete="off">
            <input type="text" id="input" maxlength="500" aria-label="Message">
            <button type="button" id="emoji-btn" aria-label="Insert an emoji">&#127773;</button>
            <button type="submit" class="submit">Send</button>
        </form>
    </section>


    <!-- integrity: the browser refuses the file if the CDN ever serves something else -->
    <script src="https://cdn.jsdelivr.net/npm/@joeattardi/emoji-button@3.1.1/dist/index.min.js" integrity="sha384-LflKKP9Vzm1ejkxP61Zdhac1BhN5UXl/QP6jhF72DmAWEpZpBwtCM0E60Cgwn6+V" crossorigin="anonymous"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/main.js"></script>
</body>
</html>
