#!/usr/bin/env node

/**
 * Module dependencies.
 */

const mongoose = require('mongoose');
const config = require('../config');
const { app } = require('../app');
const { createServer } = require('../server');

/**
 * Get port from environment and store in Express.
 */

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server and the Socket.IO signaling server (see sockets.js).
 */

const { server } = createServer();

server.on('error', onError);
server.on('listening', onListening);

/**
 * Connect to MongoDB first, then listen on provided port, on all network
 * interfaces. If the database is not reachable the app stops with a message.
 */

mongoose.connect(config.mongodbUri)
  // Makes the rooms' indexes match the model: drops the unique index on the name
  // (from before rooms were private) and creates the invite-token and expiry ones.
  .then(() => require('../models/Rooms').syncIndexes())
  .then(() => server.listen(port))
  .catch((err) => {
    console.error('MongoDB Error Connection:', err.message);
    process.exit(1);
  });

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  const bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  console.log('Listening on ' + bind);
}
